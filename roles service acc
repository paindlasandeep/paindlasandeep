---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: sandeep-service-account

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: readonly-role-sandeep
  namespace: paisandy-dev
rules:
- apiGroups: [""]
  resources:
    - pods
    - services
    - configmaps
    - secrets
    - endpoints
    - persistentvolumeclaims
    - namespaces
  verbs:
    - get
    - list
    - watch

- apiGroups: ["apps"]
  resources:
    - deployments
    - replicasets
    - statefulsets
    - daemonsets
  verbs:
    - get
    - list
    - watch

- apiGroups: ["batch"]
  resources:
    - jobs
    - cronjobs
  verbs:
    - get
    - list
    - watch

- apiGroups: ["route.openshift.io"]
  resources:
    - routes
  verbs:
    - get
    - list
    - watch

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: readonly-rolebinding-sandeep
subjects:
- kind: ServiceAccount
  name: sandeep-service-account
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: readonly-role-sandeep
